# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=precisionatv-com.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=

# Shopify Admin API reporting (read_reports + read_orders)
# Preferred for new 2026 Dev Dashboard apps:
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Optional legacy/admin-created app token:
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Public analytics config
GA4_MEASUREMENT_ID=G-ND2GJ5FD6S

# Private dashboard metrics (Google service account)
GA4_PROPERTY_ID=556833689
GSC_SITE_URL=sc-domain:precisionatvfab.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
DASHBOARD_KEY=

# inFlow order automation
# Generate these in inFlow: Settings > Integrations > API.
INFLOW_COMPANY_ID=
INFLOW_API_KEY=
INFLOW_API_VERSION=2026-09-29

# Created by POST /api/inflow-webhook-setup after the first deployment.
# inFlow only returns this secret when the webhook subscription is created.
INFLOW_WEBHOOK_SECRET=

# Optional. Used only when a Shopify-created inFlow sales order has no location.
INFLOW_DEFAULT_LOCATION_ID=

# Optional override if the public webhook URL is different from this Vercel project.
INFLOW_WEBHOOK_URL=

# Optional separate key for setup/health endpoints. DASHBOARD_KEY is used if omitted.
INTEGRATION_SETUP_KEY=
